LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Runtime / speed
MAX_AGENT_STEPS=9
MAX_CONCURRENT_TASKS=3

# Prompt routing / truncation
MAX_TASK_INPUT_CHARS=1800
MAX_POLICY_CHARS=2200

# Output budget
MAX_OUTPUT_TOKENS_PER_TURN=1200
MAX_OUTPUT_TOKENS_PER_RUN=4000

# Reasoning
REASONING_EFFORT=low

# Tool-result compaction
MAX_TOOL_RESULT_CHARS=1800

# Optional pricing. Leave 0 to track tokens without claiming a cost.
INPUT_COST_PER_1M=0
CACHED_INPUT_COST_PER_1M=0
OUTPUT_COST_PER_1M=0

DATABASE_PATH=/app/state/evals.db
DATASET_DIR=/app/data/retail
VITE_API_BASE_URL=http://localhost:8007

# Deterministic user simulator
MAX_SIMULATOR_TURNS=3
SIMULATOR_MODE=scripted
